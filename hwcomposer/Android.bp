// HAL module implemenation stored in
// hw/<OVERLAY_HARDWARE_MODULE_ID>.<ro.product.board>.so
cc_library_shared {
    name: "hwcomposer.waydroid",
    relative_install_path: "hw",
    vendor: true,
    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "libsync",
        "libui",
        "libdrm",
        "libEGL",
        "libGLESv2",
        "vendor.waydroid.clipboard@1.0",
        "vendor.waydroid.display@1.0",
        "vendor.waydroid.display@1.1",
        "vendor.waydroid.display@1.2",
        "vendor.waydroid.task@1.0",
        "vendor.waydroid.window@1.0",
        "vendor.waydroid.window@1.1",
        "vendor.waydroid.window@1.2",
    ],
    static_libs: [
        "libwayland_client",
        "libffi",
        "libwayland_extension_client_protocols",
        "libxkbcommon",
    ],
    srcs: [
        "extension.cpp",
        "gralloc_handler.cpp",
        "hwcomposer.cpp",
        "wayland-hwc.cpp",
        "WaydroidClipboard.cpp",
        "WaydroidWindow.cpp",
        "egl-tools.cpp",
        "modes/waydroid_mode.cpp",
        "modes/closed.cpp",
        "modes/full-ui.cpp",
        "modes/multi-window.cpp",
        "modes/single-window.cpp",
    ],
    header_libs: [
        "libsystem_headers",
        "minigbm_headers",
    ],
    include_dirs: [
        "system/core",
        "system/core/libsync",
        "system/core/libsync/include"
    ],
    cflags: [
        "-DLOG_TAG=\"hwcomposer\"",
        "-Wall",
        "-Werror",
    ],
    generated_sources: [
        "wayland_android_client_protocol_sources",
        "xdg_shell_client_protocol_sources",
        "fractional_scale_client_protocol_sources",
    ],
    generated_headers: [
        "wayland_android_client_protocol_headers",
        "xdg_shell_client_protocol_headers",
        "fractional_scale_client_protocol_headers",
    ],
}

// Generate wayland-android protocol source file
genrule {
    name: "wayland_android_client_protocol_sources",
    srcs: ["wayland-android.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) code < $(in) > $(out)",
    out: ["wayland-android-client-protocol.c"],
}
// Generate wayland-android protocol header file
genrule {
    name: "wayland_android_client_protocol_headers",
    srcs: ["wayland-android.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) client-header < $(in) > $(out)",
    out: ["wayland-android-client-protocol.h"],
}

// Generate the stable xdg-shell protocol here rather than relying on
// external/wayland-protocols. This tree's snapshot of that project predates the
// stable xdg-shell protocol -- it ships only unstable v5 and v6, which generate
// xdg-shell-unstable-v6-client-protocol.h and define zxdg_* names, not the
// xdg-shell-client-protocol.h and xdg_wm_base this code includes. Vendoring the
// protocol keeps the fix inside this repo, the same way wayland-android.xml is
// already handled, instead of forking wayland-protocols to add one file.
//
// Taken verbatim from wayland-protocols 1.31, stable/xdg-shell/xdg-shell.xml.
//
// Note this is still needed on Sailfish even though xdg-shell is not used
// there: the xdg code paths are compiled in and merely left unbound at runtime
// unless persist.waydroid.prefer_xdg_shell=true.
genrule {
    name: "xdg_shell_client_protocol_sources",
    srcs: ["xdg-shell.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) code < $(in) > $(out)",
    out: ["xdg-shell-client-protocol.c"],
}

genrule {
    name: "xdg_shell_client_protocol_headers",
    srcs: ["xdg-shell.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) client-header < $(in) > $(out)",
    out: ["xdg-shell-client-protocol.h"],
}

// fractional-scale-v1, vendored for the same reason as xdg-shell above: this
// tree's external/wayland-protocols predates it. It is the last protocol this
// module needs that the snapshot does not carry -- everything else it includes
// (idle-inhibit, linux-dmabuf, pointer-constraints, presentation-time,
// relative-pointer, tablet v2, viewporter) is already there.
//
// Taken verbatim from wayland-protocols 1.31,
// staging/fractional-scale/fractional-scale-v1.xml.
genrule {
    name: "fractional_scale_client_protocol_sources",
    srcs: ["fractional-scale-v1.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) code < $(in) > $(out)",
    out: ["fractional-scale-v1-client-protocol.c"],
}

genrule {
    name: "fractional_scale_client_protocol_headers",
    srcs: ["fractional-scale-v1.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) client-header < $(in) > $(out)",
    out: ["fractional-scale-v1-client-protocol.h"],
}
